	author = {Hattori, Yoshiyuki and Shuhara, Ai and Kondo, Atsushi and Utsumi, Shigenori and Tanaka, Hideki and Ohba, Tomonori and Kanoh, Hirofumi and Takahashi, Kunimitsu and Vallejos-Burgos, Fernando and Kaneko, Katsumi},
